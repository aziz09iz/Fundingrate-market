# Copy to .env.local and fill in. Never commit the filled file.
# .env* is gitignored except this example.

# ─── App password ───────────────────────────────────────────────────────────
# The one secret this app has. Signing in with it authorises every route that can
# move money, and every stored secret — exchange API keys, DEX wallet keys and
# withdrawal addresses — is encrypted with a key derived from it.
#
# Everything else is configured in the dashboard. There are deliberately no
# credential variables here: two sources of truth meant a key could be shadowed by
# one the UI could neither see nor change.
#
# Three consequences of changing this value:
#   · every signed-in session is invalidated
#   · stored exchange credentials become unreadable
#   · stored withdrawal addresses become unreadable
#
# Pick something long. To generate one:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
APP_PASSWORD=

# ─── Automation arms ────────────────────────────────────────────────────────
# Two independent locks that the dashboard cannot open. Each in-app toggle is
# necessary but not sufficient: unattended, irreversible actions should not be one
# mis-click away, so arming them requires editing this file and restarting.

# Arms the treasury rebalancing engine. Without this set to true, the engine
# evaluates and logs what it would move but never sends a withdrawal, whatever the
# in-app toggle says.
#
# Destinations have their own two-step gate in the dashboard: an address is inert
# until explicitly confirmed there. This arm is on top of that.
REBALANCE_AUTOMATION=false

# Arms the strategy engine for the LIVE account. Without this set to true the
# engine still evaluates every cycle and logs each decision it would have taken,
# but no live order is sent. The paper account ignores this and runs on its own
# toggle, since it risks nothing.
#
# Eight of the ten venues can receive a live order: the six centralized ones, plus
# Hyperliquid and Aster, whose orders are signed locally with a wallet key. edgeX is
# readable and cancellable but cannot be entered, and Lighter is market data only —
# a deployment configured only with those two will log refusals rather than trade.
#
# One arm covers every strategy — FundingSync, PerpBridge, FundingBridge and
# FundingYield — so setting it arms whichever of them is switched on, not only the
# one you were looking at.
#
# Run a strategy on paper through a few funding cycles first, read the log, and
# only then arm this.
AUTO_TRADING=false
